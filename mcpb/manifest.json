{
  "manifest_version": "0.2",
  "name": "discord-mcp",
  "version": "0.2.0",
  "description": "FastMCP 3.2 Discord MCP server with sampling, agentic workflow, and SOTA webapp",
  "author": { "name": "sandraschi" },
  "server": {
    "type": "python",
    "entry_point": "run_server.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run","--directory","${PWD}","run_server.py"],
      "env": {
        "PYTHONPATH": "${PWD}/src",
        "PYTHONUNBUFFERED": "1"
      }
    }
  },
  "tools": [
    { "name": "discord_tool", "description": "discord_tool" }
  ]
}
